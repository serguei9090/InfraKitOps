# Copy to deploy/.env and edit. Used by deploy/compose.yml.

# Public hostname Caddy serves + gets a certificate for.
#   a real FQDN → automatic Let's Encrypt HTTPS
#   localhost   → Caddy internal CA (self-signed, browser warning)
DOMAIN=localhost

# Image version label baked into /api/v1/health (cosmetic).
VERSION=dev

# Extra browser origin(s) allowed to call the API, comma-separated. Only
# needed if you serve the frontend from a DIFFERENT origin than the API
# (e.g. a CDN). Same-origin (the default single-container setup) needs nothing.
CORS_ORIGIN=

# The vault passphrase itself is NOT set here — put it in
# deploy/vault_passphrase.txt (chmod 600). It initialises the shared vault on
# first boot and unlocks it on every restart.
